<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Siemens.Engineering is .NET Framework 4.8 (Remoting). Must not run on net8+. -->
    <TargetFramework>net481</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TiaOpenness.Server</RootNamespace>
    <AssemblyName>TiaOpenness.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Description>Siemens TIA Portal Openness CLI (V19 PublicAPI). No MCP — one-shot JSON CLI for gateway/import.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TiaOpenness.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaOpenness.Models\TiaOpenness.Models.csproj" />
  </ItemGroup>

</Project>
