FUNCTION_BLOCK "FB1000_Master"
VAR_INPUT
    CmdMode : Int;
    StartCmd : Bool;
END_VAR
VAR
    statRunning : Bool;
END_VAR
BEGIN
    // ==============================================================
    // AF V1.2 Software Unit : U1_Master   (af_role = unit)
    // AF Layer              : Unit
    // AF Call Structure     : OB Main -> CallUnit(UU1_Master) -> CallEquipment/EMs -> CMs
    // --------------------------------------------------------------
    // DATA REFERENCES FROZEN / 数据引用冻结:
    //   原始 DB 名 / 符号名 / %I %Q 地址 / #变量 在下方逐字保留
    //   且语句顺序不变;仅代码组织结构重排为 AF Unit/EM/CM 分层。
    // AF ControlNodes 桥接说明(追加式,不改原始 DB 偏移):
    //   U1_Master_ControlNodes 为 AF 接口 DB(块号追加),原 DB 不动。
    // ==============================================================
// Unit mode control
    // --- [AF CallUnit | Unit 模式/状态层] 以下为原始语句(逐字、原顺序) ---
"DB1000_Global".mode := #CmdMode;
IF "I_EStop" AND #StartCmd THEN
    "DB1000_Global".running := TRUE;
END_IF;
    // --- [AF CallEquipment -> CM | 设备 IO 控制层] 以下为原始语句(逐字、原顺序) ---
"Q_FaultLamp" := %I0.3;
END_FUNCTION_BLOCK
