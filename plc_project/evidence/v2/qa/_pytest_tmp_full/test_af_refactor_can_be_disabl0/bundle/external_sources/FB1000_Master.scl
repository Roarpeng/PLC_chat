FUNCTION_BLOCK "FB1000_Master"
VAR_INPUT
    CmdMode : Int;
    StartCmd : Bool;
END_VAR
VAR
    statRunning : Bool;
END_VAR
BEGIN
// Unit mode control
"DB1000_Global".mode := #CmdMode;
IF "I_EStop" AND #StartCmd THEN
    "DB1000_Global".running := TRUE;
END_IF;
"Q_FaultLamp" := %I0.3;
END_FUNCTION_BLOCK
