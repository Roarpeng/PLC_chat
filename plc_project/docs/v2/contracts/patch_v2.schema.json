{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plc-agent.local/contracts/patch_v2.schema.json",
  "title": "V2 atomic CandidatePatch request",
  "description": "All mutating requests carry project_id + base_revision + request_id. Unknown op is fail-closed (422).",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "base_revision", "request_id", "ops"],
  "properties": {
    "project_id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "request_id": { "type": "string", "minLength": 1, "description": "idempotency key for this patch" },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {
            "enum": [
              "set_step_parameter", "set_component_parameter", "set_component_name",
              "add_component", "remove_component", "add_step", "add_transition",
              "remove_transition", "set_guard", "set_view_layout",
              "set_hardware_intent", "set_sequence_mode", "add_exception"
            ]
          },
          "step_id": { "type": "string" },
          "field": { "type": "string" },
          "value": {},
          "component_id": { "type": "string" },
          "transition_id": { "type": "string" },
          "layout": { "type": "object" },
          "guard": { "type": "object" },
          "guard_ast": { "type": "object" },
          "id": { "type": "string" },
          "ir_id": { "type": "string" },
          "source_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "explanation": { "type": "string" },
    "questions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "ops": { "contains": { "properties": { "op": { "const": "set_view_layout" } }, "required": ["op"] } } } },
      "then": { "description": "UI layout patches must not change ir_sha256" }
    }
  ]
}
