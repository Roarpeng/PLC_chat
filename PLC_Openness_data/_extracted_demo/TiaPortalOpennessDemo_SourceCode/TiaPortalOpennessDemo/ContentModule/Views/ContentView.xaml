<UserControl
    x:Class="ContentModule.Views.ContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utils="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    xmlns:viewModels="clr-namespace:ContentModule.DesignTimeViewModels"
    d:DataContext="{d:DesignInstance viewModels:ContentDesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFF0F0F0"
    mc:Ignorable="d">

    <Grid Background="#FFF0F0F0">
        <ListView
            Margin="0"
            utils:ListViewColumns.Stretch="True"
            Background="#FFF0F0F0"
            ItemsSource="{Binding ContentDictionary, Mode=OneWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Key}" Header="Name" />
                    <GridViewColumn DisplayMemberBinding="{Binding Value}" Header="Value" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>

</UserControl>
