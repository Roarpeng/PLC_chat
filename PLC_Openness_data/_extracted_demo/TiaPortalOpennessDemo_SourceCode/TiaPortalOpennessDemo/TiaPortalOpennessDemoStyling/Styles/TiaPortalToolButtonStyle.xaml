<SharedResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:TiaPortalOpennessDemoStyling.Utils">

    <SharedResourceDictionary.MergedDictionaries>
        <SharedResourceDictionary Source="pack://application:,,,/TiaPortalOpennessDemoStyling;component/Styles/ButtonToolTipStyle.xaml" />
    </SharedResourceDictionary.MergedDictionaries>

    <Style
        x:Key="TiaPortalToolButtonStyle"
        BasedOn="{StaticResource ButtonToolTipStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="50" />
        <Style.Resources>
            <Style TargetType="{x:Type utils:AutoGrayableImage}">
                <Setter Property="Width" Value="90" />
                <Setter Property="Height" Value="23" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
    </Style>

</SharedResourceDictionary>