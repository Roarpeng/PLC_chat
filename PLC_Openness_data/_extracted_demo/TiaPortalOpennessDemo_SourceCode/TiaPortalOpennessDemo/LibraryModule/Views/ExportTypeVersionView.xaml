<Window
    x:Class="LibraryModule.Views.ExportTypeVersionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="450"
    Height="190"
    local:WindowCloser.DialogResult="{Binding DialogResult}"
    local:WindowCloser.EnableWindowClosing="{Binding CanCloseDialog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            FocusManager.FocusedElement="{Binding ElementName=FileName}">
            <Grid Margin="5">
                <Label
                    Width="125"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Content="Note:" />
                <Label Margin="125,0,0,0" Padding="2">
                    <TextBlock Height="Auto" Text="The file name must be entered in full, including &#x0a;the file extension '.xml', like 'Filename.xml'" />
                </Label>
            </Grid>

            <Grid Margin="5">
                <Label
                    Width="125"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Content="Export file name:" />
                <TextBox
                    x:Name="FileName"
                    Margin="125,0,0,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding FileName, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:InvokeCommandAction Command="{Binding FileNameTextChangedCommand}" CommandParameter="{Binding Text, ElementName=FileName}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <Grid Margin="5">
                <Label
                    Width="125"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Content="Directory path:" />
                <TextBox
                    x:Name="Path"
                    Margin="125,0,0,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:InvokeCommandAction Command="{Binding ExportPathChangedCommand}" CommandParameter="{Binding Text, ElementName=Path}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
        </StackPanel>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">
            <Grid Margin="5">
                <Button
                    Width="25"
                    Margin="0,0,0,5"
                    Command="{Binding SelectTargetDirectoryCommand}">
                    ...
                </Button>
            </Grid>
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Grid>
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,0,0"
                        Command="{Binding ExportVersionCommand}">
                        Export
                    </Button>
                    <Button
                        Width="100"
                        Margin="5,0,0,0"
                        Command="{Binding CancelCommand}">
                        Cancel
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
