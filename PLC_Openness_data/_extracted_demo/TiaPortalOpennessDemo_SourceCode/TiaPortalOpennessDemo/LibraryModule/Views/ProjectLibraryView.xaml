<UserControl
    x:Class="LibraryModule.Views.ProjectLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:img="clr-namespace:TiaPortalOpennessDemoStyling.Utils;assembly=TiaPortalOpennessDemoStyling"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utils="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    d:DesignHeight="450"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFF0F0F0"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SharedResourceDictionary>
            <SharedResourceDictionary.MergedDictionaries>
                <SharedResourceDictionary Source="pack://application:,,,/TiaPortalOpennessDemoStyling;component/LookAndFeel.xaml" />
            </SharedResourceDictionary.MergedDictionaries>
            <utils:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </SharedResourceDictionary>
    </UserControl.Resources>

    <DockPanel
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#FFF0F0F0">

        <!--  Menu frame  -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button
                Command="{Binding CreateGroupCommand}"
                IsEnabled="{Binding CanCreateGroup}"
                Style="{StaticResource ButtonToolTipStyle}"
                ToolTip="Create new group">
                <StackPanel>
                    <img:AutoGrayableImage Source="{StaticResource NewGroup}" />
                </StackPanel>
            </Button>
            <Button
                Command="{Binding EditGroupCommand}"
                IsEnabled="{Binding CanEditGroup}"
                Style="{StaticResource ButtonToolTipStyle}"
                ToolTip="Edit group name">
                <StackPanel>
                    <img:AutoGrayableImage Source="{StaticResource EditGroup}" />
                </StackPanel>
            </Button>

            <Button
                Margin="2,0,0,0"
                Command="{Binding ShowCopyDialogCommand}"
                IsEnabled="{Binding CanShowCopyDialog}"
                Style="{StaticResource ButtonToolTipStyle}"
                ToolTip="Copy element to project">
                <StackPanel>
                    <img:AutoGrayableImage Source="{StaticResource CopyToProject}" />
                </StackPanel>
            </Button>
            <Button
                Margin="10,0,0,0"
                Command="{Binding ExportVersionCommand}"
                IsEnabled="{Binding CanExportVersion}"
                Style="{StaticResource ButtonToolTipStyle}"
                ToolTip="Export version">
                <StackPanel>
                    <img:AutoGrayableImage Source="{StaticResource ExportVersion}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Copy from project library to project  -->
        <StackPanel
            Background="#3B4461"
            DockPanel.Dock="Top"
            Orientation="Vertical"
            Visibility="{Binding CopyLibElement, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <Label Content="Copy from project library to project" Foreground="White" />
            </StackPanel>
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label
                    Width="80"
                    Content="Source:"
                    Foreground="White" />
                <TextBox
                    Width="200"
                    IsReadOnly="True"
                    Text="{Binding CopySourceInformation}" />
            </StackPanel>
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <Label
                    Width="80"
                    Content="Destination:"
                    Foreground="White" />
                <TextBox
                    Width="200"
                    IsReadOnly="True"
                    Text="{Binding CopyDestination.Header}" />
            </StackPanel>
            <StackPanel Margin="110,0,0,0" Orientation="Horizontal">
                <Button
                    Width="70"
                    Margin="10,10,10,10"
                    Command="{Binding ExecuteCopyCommand}"
                    Content="Copy" />
                <Button
                    Width="70"
                    Margin="10,10,10,10"
                    Command="{Binding CancelCopyCommand}"
                    Content="Cancel" />
            </StackPanel>
        </StackPanel>

        <!--  project library tree  -->
        <Grid>
            <ScrollViewer
                CanContentScroll="True"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <TreeView
                    x:Name="Tree"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    utils:TreeViewHelper.SelectedItem="{Binding ProjectLibraryTreeViewHandler.SelectedItem}"
                    utils:TreeViewHelper.SelectedItemChanged="{Binding ProjectLibraryTreeViewHandler.SelectedItemChgCmd}"
                    Background="#FFF0F0F0"
                    DockPanel.Dock="Top"
                    ItemContainerStyle="{StaticResource StaysHighlightedTreeViewItem}"
                    ItemsSource="{Binding ProjectLibraryTreeViewHandler.View, Mode=OneWay}"
                    SelectedValuePath="Header">
                    <TreeView.Resources>
                        <Style TargetType="{x:Type TreeView}">
                            <Setter Property="BorderThickness">
                                <Setter.Value>0.0</Setter.Value>
                            </Setter>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFF0F0F0" />
                                </Setter.Value>
                            </Setter>
                            <Style.Resources>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Style.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF3399FF" />
                                    </Style.Resources>
                                </Style>
                            </Style.Resources>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </ScrollViewer>
        </Grid>

    </DockPanel>

</UserControl>
