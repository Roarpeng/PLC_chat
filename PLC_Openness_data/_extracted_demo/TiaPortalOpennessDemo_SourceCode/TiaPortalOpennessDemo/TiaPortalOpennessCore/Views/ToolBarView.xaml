<UserControl
    x:Class="TiaPortalOpennessCore.Views.ToolBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:img="clr-namespace:TiaPortalOpennessDemoStyling.Utils;assembly=TiaPortalOpennessDemoStyling"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="50"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  Resources  -->
    <UserControl.Resources>
        <SharedResourceDictionary>
            <SharedResourceDictionary.MergedDictionaries>
                <SharedResourceDictionary Source="pack://application:,,,/TiaPortalOpennessDemoStyling;component/LookAndFeel.xaml" />
            </SharedResourceDictionary.MergedDictionaries>
        </SharedResourceDictionary>
    </UserControl.Resources>

    <!--  Toolbar  -->
    <StackPanel
        HorizontalAlignment="Stretch"
        Background="#FF3B4461"
        Orientation="Horizontal">
        <Button
            Command="{Binding OpenProjectCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Open project">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource OpenProject}" />
                <TextBlock Text="Open project" />
            </StackPanel>
        </Button>
        <Button
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Refresh">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource UpdateView}" />
                <TextBlock Text="Refresh" />
            </StackPanel>
        </Button>
        <Button
            Command="{Binding SaveLocalSessionCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Save local Session">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource SaveProject}" />
                <TextBlock Text="Save local Session" />
            </StackPanel>
        </Button>
        <Button
            Command="{Binding SaveProjectCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Save project">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource SaveProject}" />
                <TextBlock Text="Save project" />
            </StackPanel>
        </Button>
        <Button
            Command="{Binding ExecuteCompilerCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Compile selected tree element">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource Compiler}" />
                <TextBlock Text="Compile" />
            </StackPanel>
        </Button>
        <Button
            Command="{Binding ImportElementCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Import Element">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource ImportElement}" />
                <TextBlock Text="Import Element" />
            </StackPanel>
        </Button>
        <Button
            Command="{Binding ExportStructureCommand}"
            IsEnabled="{Binding BaseServiceLoaded}"
            Style="{StaticResource TiaPortalToolButtonStyle}"
            ToolTip="Export Structure">
            <StackPanel>
                <img:AutoGrayableImage Source="{StaticResource ExportStructure}" />
                <TextBlock Text="Export Structure" />
            </StackPanel>
        </Button>
    </StackPanel>

</UserControl>
