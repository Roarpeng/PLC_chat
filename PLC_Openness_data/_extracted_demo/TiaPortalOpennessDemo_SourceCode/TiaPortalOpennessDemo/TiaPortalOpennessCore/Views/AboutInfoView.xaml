<Window
    x:Class="TiaPortalOpennessCore.Views.AboutInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TiaPortalOpennessCore.Utils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:TiaPortalOpennessCore.DesignTimeViewModels"
    Title="{Binding Title}"
    Width="500"
    Height="300"
    d:DataContext="{d:DesignInstance viewModels:AboutInfoDesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    local:WindowCloser.DialogResult="{Binding DialogResult}"
    local:WindowCloser.EnableWindowClosing="True"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFF0F0F0"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="5,0,0,0">
            <Label Content="Application Info:" />
        </Grid>
        <!--  Content  -->
        <Grid Grid.Row="1" Margin="5,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <!--  Left side  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <ListBox Name="TraceMonitor" ItemsSource="{Binding SystemInfo}" />
                </Grid>
            </Grid>
            <!--  Right side  -->
            <Grid Grid.Column="1" Margin="5">
                <Button
                    x:Name="CopyToClipBoard"
                    Height="Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Command="{Binding CopyInfoCommand}"
                    Content="Copy Info" />

            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="5,5,5,5">
            <Button
                Width="{Binding ElementName=CopyToClipBoard, Path=ActualWidth}"
                Height="Auto"
                HorizontalAlignment="Right"
                Command="{Binding ConfirmationCommand}"
                Content="Ok" />
        </Grid>
    </Grid>




</Window>
