<Window
    x:Class="TiaPortalOpennessDemo.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TiaPortalOpennessDemo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inf="clr-namespace:TiaPortalOpennessInfrastructure.Constants;assembly=TiaPortalOpennessInfrastructure"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="800"
    Height="650"
    MinWidth="250"
    MinHeight="250"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFF0F0F0"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Tia Portal slide  -->
        <Storyboard x:Key="ShowTiaPortalSlidePanel">
            <ThicknessAnimation
                DecelerationRatio="0.9"
                Storyboard.TargetProperty="Margin"
                From="-300,73,0,0"
                To="0,73,0,0"
                Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Key="HideTiaPortalSlidePanel">
            <ThicknessAnimation
                DecelerationRatio="0.9"
                Storyboard.TargetProperty="Margin"
                From="0,73,0,0"
                To="-300,73,0,0"
                Duration="0:0:0.5" />
        </Storyboard>
        <!--  Library slide  -->
        <Storyboard x:Key="HideLibrarySlidePanel">
            <ThicknessAnimation
                DecelerationRatio="0.9"
                Storyboard.TargetProperty="Margin"
                From="0,73,0,0"
                To="0,73,-300,0"
                Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Key="ShowLibrarySlidePanel">
            <ThicknessAnimation
                DecelerationRatio="0.9"
                Storyboard.TargetProperty="Margin"
                From="0,73,-300,0"
                To="0,73,0,0"
                Duration="0:0:0.5" />
        </Storyboard>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!--  Horizontal splitter  -->
        <Style x:Key="HorizontalBevelGrip" TargetType="{x:Type controls:DockPanelSplitter}">
            <Setter Property="Thickness" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:DockPanelSplitter}">
                        <Grid
                            Background="LightGray"
                            SnapsToDevicePixels="True"
                            ToolTip="Resize">
                            <!--  Grip  -->
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Fill="#5A000000" />
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Margin="2,0,2,0"
                                    Fill="#5A000000" />
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Fill="#5A000000" />
                            </StackPanel>
                            <Border BorderBrush="#5AFFFFFF" BorderThickness="0,1,0,0" />
                            <Border BorderBrush="#5A000000" BorderThickness="0,0,0,1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Vertical splitter  -->
        <Style x:Key="VerticalBevelGrip" TargetType="{x:Type controls:DockPanelSplitter}">
            <Setter Property="Thickness" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:DockPanelSplitter}">
                        <Grid
                            Background="LightGray"
                            SnapsToDevicePixels="True"
                            ToolTip="Resize">
                            <!--  Grip  -->
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Fill="#5A000000" />
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Margin="0,2,0,2"
                                    Fill="#5A000000" />
                                <Rectangle
                                    Width="2"
                                    Height="2"
                                    Fill="#5A000000" />
                            </StackPanel>
                            <Border BorderBrush="#5AFFFFFF" BorderThickness="1,0,0,0" />
                            <Border BorderBrush="#5A000000" BorderThickness="0,0,1,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel x:Name="DockPanelMainView">

            <!--  Menu region  -->
            <Grid
                Name="MenuPanel"
                Height="23"
                MinHeight="20"
                DockPanel.Dock="Top">
                <ContentControl Height="Auto" prism:RegionManager.RegionName="{x:Static inf:RegionNames.MenuRegion}" />
            </Grid>

            <!--  Toolbar region  -->
            <Grid
                Name="ToolPanel"
                Height="50"
                DockPanel.Dock="Top">
                <StackPanel Height="Auto" prism:RegionManager.RegionName="{x:Static inf:RegionNames.ToolBarRegion}" />
            </Grid>

            <!--  Trace monitor  -->
            <Grid
                Name="FooterPanel"
                Height="100"
                Margin="20,0,0,0"
                DockPanel.Dock="Bottom">
                <ListBox Name="TraceMonitor" ItemsSource="{Binding TraceLog}" />
            </Grid>
            <controls:DockPanelSplitter DockPanel.Dock="Bottom" Style="{StaticResource HorizontalBevelGrip}" />

            <!--  Navigation region  -->
            <Grid
                Name="NavigationPanel"
                Width="300"
                MinWidth="100"
                Margin="20,5,5,5"
                DockPanel.Dock="Left">
                <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.ProjectTreeRegion}" />
            </Grid>
            <controls:DockPanelSplitter DockPanel.Dock="Left" Style="{StaticResource VerticalBevelGrip}" />

            <!--  Content region  -->
            <Grid
                Name="MainPanel"
                MinWidth="200"
                Margin="0,0,20,0">
                <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.ContentRegion}" />
            </Grid>

        </DockPanel>

        <!--  Tia portal region / Local Session region  -->
        <Grid>
            <DockPanel
                Name="TiaPortalSlidePanel"
                Margin="-300,73,0,0"
                HorizontalAlignment="Left"
                Panel.ZIndex="2">
                <Border
                    Name="TiaPortalSlidePanelBorder"
                    Width="300"
                    Background="#FFF0F0F0"
                    BorderBrush="#5A000000"
                    BorderThickness="1">
                    <DockPanel VerticalAlignment="Stretch">
                        <Button
                            Name="HideTiaPortalSlidePanel"
                            Width="{Binding ActualWidth, ElementName=TiaPortalSlidePanelBorder}"
                            Height="25"
                            HorizontalAlignment="Stretch"
                            BorderBrush="#FFF0F0F0"
                            DockPanel.Dock="Top">
                            <DockPanel Width="{Binding ActualWidth, ElementName=TiaPortalSlidePanelBorder}">
                                <Image
                                    Width="Auto"
                                    Margin="5,0,0,0"
                                    DockPanel.Dock="Right"
                                    Source="pack://application:,,,/TIAPortalOpennessInfrastructure;component/Images/Navigation/ArrowToLeft.ico" />
                                <Label
                                    Padding="10,0,0,0"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Content="TIA Portal"
                                    DockPanel.Dock="Left" />
                            </DockPanel>
                        </Button>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.TiaPortalRegion}" DockPanel.Dock="Top" />
                            <!--<ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.LocalSessionRegion}" DockPanel.Dock="Top" />-->
                        </DockPanel>
                    </DockPanel>
                </Border>
                <Grid Background="#FFF0F0F0">
                    <WrapPanel Margin="0,20,0,0" Background="#FFF0F0F0">
                        <Button
                            x:Name="ShowTiaPortalSlidePanel"
                            Width="100"
                            Height="20"
                            Padding="5,0,5,0"
                            BorderThickness="0"
                            Content="TIA Portal"
                            ToolTip="TIA Portal information">
                            <Button.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </Button.LayoutTransform>
                        </Button>
                    </WrapPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!--  Project Library region / Global Library region  -->
        <Grid>
            <DockPanel
                Name="LibrarySlidePanel"
                Margin="0,73,-300,0"
                HorizontalAlignment="Right"
                Panel.ZIndex="2">
                <Grid>
                    <WrapPanel Margin="-20,20,0,0">
                        <Button
                            x:Name="ShowLibrarySlidePanel"
                            Width="100"
                            Height="20"
                            Padding="5,0,5,0"
                            BorderThickness="0"
                            Content="Libraries"
                            ToolTip="Library information">
                            <Button.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </Button.LayoutTransform>
                        </Button>
                    </WrapPanel>
                </Grid>
                <Border
                    Name="LibrarySlidePanelBorder"
                    Width="300"
                    Background="#FFF0F0F0"
                    BorderBrush="#5A000000"
                    BorderThickness="1">
                    <DockPanel VerticalAlignment="Stretch">
                        <Button
                            Name="HideLibrarySlidePanel"
                            Width="{Binding ActualWidth, ElementName=LibrarySlidePanelBorder}"
                            Height="25"
                            HorizontalAlignment="Stretch"
                            BorderBrush="#FFF0F0F0"
                            DockPanel.Dock="Top">
                            <DockPanel Width="{Binding ActualWidth, ElementName=LibrarySlidePanelBorder}">
                                <Image
                                    Width="Auto"
                                    Margin="0,0,5,0"
                                    DockPanel.Dock="Left"
                                    Source="pack://application:,,,/TIAPortalOpennessInfrastructure;component/Images/Navigation/ArrowToRight.ico" />
                                <Label
                                    Padding="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalContentAlignment="Center"
                                    Content="Libraries"
                                    DockPanel.Dock="Right" />
                            </DockPanel>
                        </Button>
                        <DockPanel DockPanel.Dock="Top">
                            <Grid>

                                <TabControl Background="#FFF0F0F0" TabStripPlacement="Bottom">
                                    <TabItem Background="#FFF0F0F0" Header="Project library">
                                        <Grid>
                                            <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.ProjectLibraryRegion}" Background="#FFF0F0F0" />
                                        </Grid>
                                    </TabItem>
                                    <TabItem Background="#FFF0F0F0" Header="Global libraries">
                                        <Grid>
                                            <ContentControl prism:RegionManager.RegionName="{x:Static inf:RegionNames.GlobalLibraryRegion}" Background="#FFF0F0F0" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                            </Grid>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>

        <!--  Busy overlay  -->
        <Border
            Background="DimGray"
            BorderBrush="Black"
            BorderThickness="1"
            Opacity="0.5"
            Visibility="{Binding Path=IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="LightGray"
                        Text="Please wait..."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="LightGray"
                        Text="{Binding ProcessInfo}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Name="IamBusy"
                        Width="200"
                        Height="20"
                        Margin="5"
                        HorizontalAlignment="Center"
                        IsIndeterminate="True"
                        Opacity="1" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
