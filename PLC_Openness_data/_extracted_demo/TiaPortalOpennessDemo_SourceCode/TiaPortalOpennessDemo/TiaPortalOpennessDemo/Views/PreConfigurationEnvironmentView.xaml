<Window
    x:Class="TiaPortalOpennessDemo.Views.PreConfigurationEnvironmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:TiaPortalOpennessAdapter.Models;assembly=TiaPortalOpennessAdapter"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:TiaPortalOpennessDemo.DesignTimeViewModels"
    Title="{Binding Title}"
    Width="500"
    Height="305"
    d:DataContext="{d:DesignInstance viewModels:PreConfigurationDesignViewModel,
                                     IsDesignTimeCreatable=True}"
    local:WindowCloser.DialogResult="{Binding DialogResult}"
    local:WindowCloser.EnableWindowClosing="True"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <DockPanel LastChildFill="False">
        <Border
            Height="2"
            Background="#FF3B4461"
            DockPanel.Dock="Top" />
        <Border
            Height="2"
            Background="#FF3B4461"
            DockPanel.Dock="Bottom" />
        <Border
            Width="2"
            Background="#FF3B4461"
            DockPanel.Dock="Left" />
        <Border
            Width="2"
            Background="#FF3B4461"
            DockPanel.Dock="Right" />
        <Grid Margin="5" DockPanel.Dock="Top">
            <Label
                Width="145"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Content="Module expansions path:" />
            <TextBox
                x:Name="ModuleExpansionsPath"
                Width="305"
                Margin="145,0,0,0"
                HorizontalAlignment="Left"
                VerticalContentAlignment="Center"
                KeyDown="ModuleExpansionsPath_OnKeyDown"
                Text="{Binding ModulePath}" />
            <Button
                Margin="450,0,0,0"
                Command="{Binding GetPathFromModulesAndOptionsCommand}"
                Content="..."
                DockPanel.Dock="Bottom" />
        </Grid>
        <Grid Margin="5" DockPanel.Dock="Top">
            <ListBox
                x:Name="ModulesAndOptions"
                MinHeight="180"
                MaxHeight="180"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding ModulesAndOptions}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding Path=ModulesAndOptions, UpdateSourceTrigger=PropertyChanged}"
                SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:TiaPortalModulesAndOptions">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" SharedSizeGroup="Column1" />
                                <ColumnDefinition Width="200" SharedSizeGroup="Column2" />
                                <ColumnDefinition Width="70" SharedSizeGroup="Column3" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Margin="5,0,5,0"
                                Content="{Binding AssemblyName}"
                                IsChecked="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1" Text="{Binding EngineeringDll}" />
                            <TextBlock Grid.Column="2" Text="{Binding VersionInfo}" />
                            <!--<ListBoxItem>
                            <CheckBox
                                Margin="5,0,5,0"
                                Content="{Binding ModuleName}"
                                IsChecked="{Binding IsSelected}" />
                        </ListBoxItem>-->
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Grid Margin="5" DockPanel.Dock="Top">
            <Button
                Height="25"
                Margin="0"
                Command="{Binding ConfirmationCommand}"
                Content="Confirm"
                DockPanel.Dock="Bottom"
                IsDefault="True" />
        </Grid>
    </DockPanel>
</Window>

