<Window
    x:Class="TiaPortalOpennessDemo.Views.PreSelectionAssemblyVersionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:TiaPortalOpennessDemo.DesignTimeViewModels"
    Title="{Binding Title}"
    Width="300"
    Height="200"
    d:DataContext="{d:DesignInstance viewModels:PreSelectionAssemblyDesignViewModel,
                                     IsDesignTimeCreatable=True}"
    local:WindowCloser.DialogResult="{Binding DialogResult}"
    local:WindowCloser.EnableWindowClosing="{Binding CanCloseDialog}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <DockPanel LastChildFill="False">
        <Border
            Height="2"
            Background="#FF3B4461"
            DockPanel.Dock="Top" />
        <Border
            Height="2"
            Background="#FF3B4461"
            DockPanel.Dock="Bottom" />
        <Border
            Width="2"
            Background="#FF3B4461"
            DockPanel.Dock="Left" />
        <Border
            Width="2"
            Background="#FF3B4461"
            DockPanel.Dock="Right" />
        <Grid Margin="5" DockPanel.Dock="Top">
            <Label
                Width="110"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Content="TIA Portal Version:" />
            <ComboBox
                Margin="110,0,0,0"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding EngineeringVersions}"
                SelectedItem="{Binding SelectedEngineeringVersion}" />
        </Grid>
        <Grid Margin="5" DockPanel.Dock="Top">
            <Label
                Width="110"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Content="Openness Version:" />
            <ComboBox
                Margin="110,0,0,0"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding OpennessApiVersions}"
                SelectedItem="{Binding SelectedOpennessApiVersion}" />
        </Grid>
        <Button
            Margin="5"
            Command="{Binding ConfirmationCommand}"
            Content="Confirm"
            DockPanel.Dock="Bottom" />
        <CheckBox
            Margin="5"
            HorizontalAlignment="Center"
            Content="Do not show this window again"
            DockPanel.Dock="Bottom"
            IsChecked="{Binding HidePreSelectionAssemblyVersionDialog}" />
    </DockPanel>
</Window>
