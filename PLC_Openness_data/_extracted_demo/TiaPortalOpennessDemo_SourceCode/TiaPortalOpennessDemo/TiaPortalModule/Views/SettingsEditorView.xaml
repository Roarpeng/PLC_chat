<Window
    x:Class="TiaPortalModule.Views.SettingsEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:util="clr-namespace:TiaPortalModule.Utils"
    xmlns:viewModels="clr-namespace:TiaPortalModule.DesignTimeViewModels"
    Title="{Binding Title}"
    Width="420"
    Height="790"
    d:DataContext="{d:DesignInstance viewModels:SettingsEditorDesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    local:WindowCloser.DialogResult="{Binding DialogResult}"
    local:WindowCloser.EnableWindowClosing="{Binding CanCloseDialog}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFF0F0F0"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <util:TiaPortalModeSelectionConverter x:Key="TiaPortalModeSelectionConverter" />
    </Window.Resources>

    <StackPanel Orientation="Vertical">
        <!--  Openness version pre selection  -->
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="Openness version pre selection">
            <Grid Margin="0" Background="#FFF0F0F0">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="5,5,5,5">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="Hide pre selection"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding HidePreSelectionVersionDialog, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="5,0,5,5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="TIA Portal Version:" />
                        <ComboBox
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding EngineeringVersions}"
                            SelectedItem="{Binding SelectedEngineeringVersion}" />
                    </Grid>
                    <Grid Margin="5,0,5,5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="Openness Version:" />
                        <ComboBox
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding OpennessApiVersions}"
                            SelectedItem="{Binding SelectedOpennessApiVersion}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </GroupBox>
        <!--  Pre configuration environment  -->
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="Pre configuration environment">
            <Grid Margin="0" Background="#FFF0F0F0">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="5,5,5,0">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="SinamicsStartdriveModule"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding LoadSinamicsStartdriveModule}" />
                    </Grid>
                    <Grid Margin="5,0,5,0">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="Step7Module"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding LoadStep7Module}" />
                    </Grid>
                    <Grid Margin="5,0,5,0">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="WinCcProfessionalModule"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding LoadWinCcProfessionalModule}" />
                    </Grid>
                    <Grid Margin="5,0,5,0">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="WinCcUnifiedModule"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding LoadWinCcUnifiedModule}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </GroupBox>
        <!--  Location and Storage  -->
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="Location and Storage">
            <Grid Margin="0" Background="#FFF0F0F0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Grid Margin="5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="Module expansions:" />
                        <TextBox
                            x:Name="ModuleAndOptionPath"
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding ModuleAndOptionPath}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding ModuleAndOptionPathChangedCommand}" CommandParameter="{Binding Text, ElementName=ModuleAndOptionPath}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </Grid>
                    <Grid Margin="5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="TIA Portal projects:" />
                        <TextBox
                            x:Name="TiaPortalProjectPath"
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding TiaPortalProjectPath}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding TiaPortalProjectPathChangedCommand}" CommandParameter="{Binding Text, ElementName=TiaPortalProjectPath}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </Grid>
                    <Grid Margin="5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="Global user library:" />
                        <TextBox
                            x:Name="GlobalUserLibraryPath"
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding GlobalUserLibraryPath}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding GlobalUserLibraryPathChangedCommand}" CommandParameter="{Binding Text, ElementName=GlobalUserLibraryPath}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </Grid>
                    <Grid Margin="5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="Local sessions:" />
                        <TextBox
                            x:Name="LocalSessionPath"
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding LocalSessionPath}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding LocalSessionPathChangedCommand}" CommandParameter="{Binding Text, ElementName=LocalSessionPath}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </Grid>
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Grid Margin="5">
                        <Button
                            Width="25"
                            Height="{Binding ActualHeight, ElementName=ModuleAndOptionPath}"
                            Command="{Binding ModuleAndOptionPathCommand}">
                            ...
                        </Button>
                    </Grid>
                    <Grid Margin="5">
                        <Button
                            Width="25"
                            Height="{Binding ActualHeight, ElementName=TiaPortalProjectPath}"
                            Command="{Binding TiaPortalProjectPathCommand}">
                            ...
                        </Button>
                    </Grid>
                    <Grid Margin="5">
                        <Button
                            Width="25"
                            Height="{Binding ActualHeight, ElementName=GlobalUserLibraryPath}"
                            Command="{Binding GlobalUserLibraryPathCommand}">
                            ...
                        </Button>
                    </Grid>
                    <Grid Margin="5">
                        <Button
                            Width="25"
                            Height="{Binding ActualHeight, ElementName=LocalSessionPath}"
                            Command="{Binding LocalSessionPathCommand}">
                            ...
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </GroupBox>
        <!--  Export  -->
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="Export">
            <Grid Margin="0" Background="#FFF0F0F0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Grid Margin="5">
                        <Label
                            Width="125"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Content="Export path:" />
                        <TextBox
                            x:Name="ExportPath"
                            Height="Auto"
                            Margin="125,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding ExportPathChangedCommand}" CommandParameter="{Binding Text, ElementName=ExportPath}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </Grid>
                    <Grid Margin="5,5,5,0">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="Export with defaults"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding ExportWithDefaults}" />
                    </Grid>
                    <Grid Margin="5,0,5,0">
                        <CheckBox
                            Margin="125,5,0,5"
                            HorizontalAlignment="Left"
                            Content="Export read only"
                            DockPanel.Dock="Bottom"
                            IsChecked="{Binding ExportReadOnly}" />
                    </Grid>
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Grid Margin="5">
                        <Button
                            Width="25"
                            Height="{Binding ActualHeight, ElementName=ExportPath}"
                            Command="{Binding ExportPathCommand}">
                            ...
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </GroupBox>
        <!--  TIA Portal  -->
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="TIA Portal">
            <Grid Margin="0" Background="#FFF0F0F0">
                <StackPanel Orientation="Vertical">
                    <RadioButton
                        Margin="132,5,0,5"
                        HorizontalAlignment="Left"
                        Content="With user interface"
                        IsChecked="{Binding Path=SelectedTiaPortalMode, Converter={StaticResource TiaPortalModeSelectionConverter}, ConverterParameter=WithUserInterface, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <RadioButton
                        Margin="132,0,0,5"
                        HorizontalAlignment="Left"
                        Content="Without user interface"
                        IsChecked="{Binding Path=SelectedTiaPortalMode, Converter={StaticResource TiaPortalModeSelectionConverter}, ConverterParameter=WithoutUserInterface, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </GroupBox>
        <!--  Tree view  -->
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="Tree view">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="171*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.ColumnSpan="2"
                    Width="125"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Content="Initial expand level:" />
                <Grid
                    Grid.Column="1"
                    Height="25"
                    Margin="105,0,0,0">
                    <TextBox
                        x:Name="TreeExpandLevel"
                        Width="30"
                        Height="Auto"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsReadOnly="True"
                        Text="{Binding TreeExpandLevel}"
                        ToolTip="In the range 1 to 99">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="TextChanged">
                                <i:InvokeCommandAction Command="{Binding TreeExpandLevelChangedCommand}" CommandParameter="{Binding Text, ElementName=TreeExpandLevel}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Button
                        Width="21"
                        Margin="30,0,0,12"
                        Padding="0,-2,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ExpandLevelUpCommand}"
                        Content="▲"
                        FontSize="8" />
                    <Button
                        Width="21"
                        Margin="30,12,0,0"
                        Padding="0,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ExpandLevelDownCommand}"
                        Content="▼"
                        FontSize="8" />
                </Grid>
            </Grid>
        </GroupBox>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Grid>
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,0,0"
                        Command="{Binding ResetCommand}">
                        Reset
                    </Button>
                    <Button
                        Width="100"
                        Margin="5,0,0,0"
                        Command="{Binding SaveCommand}">
                        Save and Close
                    </Button>
                    <Button
                        Width="100"
                        Margin="5,0,0,0"
                        Command="{Binding CancelCommand}">
                        Cancel
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

    </StackPanel>
</Window>
