<Window
    x:Class="ProjectModule.Views.CaxImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:ProjectModule.DesignTimeViewModels"
    Title="{Binding Title}"
    Width="450"
    Height="150"
    d:DataContext="{d:DesignInstance viewModels:CaxImportDesignTimeViewModel,
                                     IsDesignTimeCreatable=True}"
    local:WindowCloser.DialogResult="{Binding DialogResult}"
    local:WindowCloser.EnableWindowClosing="{Binding CanCloseDialog}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Grid Margin="5">
                <Label
                    Width="110"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Content="CAx import file:" />
                <TextBox
                    x:Name="Path"
                    Margin="110,0,0,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding CaxImportFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:InvokeCommandAction Command="{Binding CaxImportFileChangedCommand}" CommandParameter="{Binding Text, ElementName=Path}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    Width="110"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Content="CAx import option:" />
                <ComboBox
                    Grid.Column="1"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="OptionName"
                    ItemsSource="{Binding CaxImportOptionInfos}"
                    SelectedItem="{Binding SelectedCaxImportOptionInfo}" />
            </Grid>
        </StackPanel>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Grid Margin="5">
                <Button
                    Width="25"
                    Margin="0,0,0,5"
                    Command="{Binding SelectCaxImportFileCommand}">
                    ...
                </Button>
            </Grid>
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Grid>
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,0,0"
                        Command="{Binding CaxImportCommand}">
                        Import
                    </Button>
                    <Button
                        Width="100"
                        Margin="5,0,0,0"
                        Command="{Binding CancelCommand}">
                        Cancel
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
