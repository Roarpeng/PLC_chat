<UserControl
    x:Class="MultiuserProjectModule.Views.MultiuserPhysicalProjectTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utils="clr-namespace:TiaPortalOpennessCore.Utils;assembly=TiaPortalOpennessCore"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#FFF0F0F0"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SharedResourceDictionary>
            <SharedResourceDictionary.MergedDictionaries>
                <SharedResourceDictionary Source="pack://application:,,,/TiaPortalOpennessDemoStyling;component/LookAndFeel.xaml" />
            </SharedResourceDictionary.MergedDictionaries>
        </SharedResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="#FFF0F0F0">
        <GroupBox
            Margin="5"
            Background="#FFF0F0F0"
            Header="Local session physical project tree">
            <TreeView
                x:Name="Tree"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                utils:TreeViewHelper.SelectedItem="{Binding ProjectTreeViewHandler.SelectedItem}"
                utils:TreeViewHelper.SelectedItemChanged="{Binding ProjectTreeViewHandler.SelectedItemChgCmd}"
                Background="#FFF0F0F0"
                ItemContainerStyle="{StaticResource StaysHighlightedTreeViewItem}"
                ItemsSource="{Binding ProjectTreeViewHandler.View, Mode=OneWay}"
                SelectedValuePath="Header">
                <TreeView.Resources>
                    <Style TargetType="{x:Type TreeView}">
                        <Setter Property="BorderThickness">
                            <Setter.Value>0.0</Setter.Value>
                        </Setter>
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#FFF0F0F0" />
                            </Setter.Value>
                        </Setter>
                        <Style.Resources>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF3399FF" />
                                </Style.Resources>
                            </Style>
                        </Style.Resources>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </GroupBox>
    </DockPanel>
</UserControl>
