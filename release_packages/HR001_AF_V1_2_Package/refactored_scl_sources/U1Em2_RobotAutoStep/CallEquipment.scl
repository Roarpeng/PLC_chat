FUNCTION_BLOCK "CallEquipment"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    controlNodes : "ControlNodes";
END_VAR
VAR
    statUnitStatus : "LUC_typeUnitStatus";
    instInterlink : "LUC_InterlinkToParent";
    instControlEm : "LAF_ControlEm";
    instMapStatus : "LAF_MapUnitStatusToSequence";
    instSequence : "Sequence";
    inst_cylRobotAutoStepFeed : "LBC_TwoWayActuator";
    inst_sensorRobotAutoStepReady : "LBC_DigitalSignal";
END_VAR
BEGIN
    // Step 1: Interlink to Parent Unit
    #instInterlink(
        unitStatus => #statUnitStatus
    );
    #instControlEm(
        unitStatus := #statUnitStatus
    );

    // Step 2 & 3: Map Unit Status to Sequence
    #instMapStatus(
        unitStatus := #statUnitStatus,
        sequenceCommands => #controlNodes.sequence.commands
    );

    // Step 4: Call FB Sequence
    #instSequence(
        controlNodes := #controlNodes
    );

    // Step 5: Call Control Modules
    // Call CM: cylRobotAutoStepFeed (LBC_TwoWayActuator)
    #inst_cylRobotAutoStepFeed(
        enableManualCmds := #statUnitStatus.mode.manual,
        controlNodes := #controlNodes.cylRobotAutoStepFeed
    );

    // Call CM: sensorRobotAutoStepReady (LBC_DigitalSignal)
    #inst_sensorRobotAutoStepReady(
        controlNodes := #controlNodes.sensorRobotAutoStepReady
    );

    // Step 6: Determine State Complete (SC)
    // #emFeedback.stateComplete := #controlNodes.sequence.status.stateComplete;

